{
  "manifest_version": 2,
  "name": "Bad Extension",
  "version": "1.0.0",
  "description": "Reference faulty extension for the real-extension bisect workflow.",
  "browser_specific_settings": {
    "gecko": {
      "id": "bad-extension@browser-extension-bisect.test"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
